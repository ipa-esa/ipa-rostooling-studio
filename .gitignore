# Local Maven build tree for the RosTooling language servers (Fraunhofer IPA, Apache-2.0).
# Not part of the portable plugin. The one JAR the oracle actually needs by default
# (tests/oracle/ask_oracle.py: JAR_CURRENT) is re-included below.
build/**
!build/ros2-ls/
!build/ros2-ls/target/
!build/ros2-ls/target/de.fraunhofer.ipa.rostooling.ls-3.1.0-SNAPSHOT-ls.jar

# Python
__pycache__/
*.pyc

# Demo content and IDE metadata -- not part of the reusable plugin
examples/
.idea/

# CoreSense Studio frontend build inputs. The BUILT bundle (web/studio/dist/) is committed
# on purpose -- the server serves it directly and nobody should need npm to run the app --
# but node_modules is 73 MB / 5,500 files of dependency tree and must never be committed.
web/studio/frontend/node_modules/

# ask_oracle.py writes this when results.json has uncommitted changes (see _results_path)
tests/oracle/results.local.json

graphify-out/


# Created by https://www.toptal.com/developers/gitignore/api/visualstudiocode
# Edit at https://www.toptal.com/developers/gitignore?templates=visualstudiocode

### VisualStudioCode ###
.vscode/*
.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets

# Local History for Visual Studio Code
.history/

# Built Visual Studio Code Extensions
*.vsix

### VisualStudioCode Patch ###
# Ignore all local history of files
.history
.ionide

# End of https://www.toptal.com/developers/gitignore/api/visualstudiocode