probe_pkg:
  artifacts:
    talker:
      node: talker
      publishers:
        'chatter':
          type: 'probe_msgs/msg/Reading'
          qos:
            reliability: reliable
      parameters:
        'rate':
          type: Integer
          default: 10
    lib_only:
      @audit:
        channel: "bad"
    listener:
      node: listener
      subscribers:
        'chatter':
          type: 'probe_msgs/msg/Reading'
