probe_sys:
  fromFile: "probe.launch.py"  # caller-supplied
  processes:
    "main":
      nodes: [talker, listener]
  nodes:
    "talker":
      from: "probe_pkg.talker"
      interfaces:
        - "chatter_pub": pub-> "talker::chatter"
    "listener":
      from: "probe_pkg.listener"
      interfaces:
        - "chatter_sub": sub-> "listener::chatter"
  connections:
    - ["chatter_pub", "chatter_sub"]
